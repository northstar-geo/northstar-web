{
  "name": "northstar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:assets": "tsx scripts/generate-geo-assets.ts",
    "prebuild": "npm run data:assets",
    "predev": "npm run data:assets",
    "pretest": "npm run data:assets",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "release:lab": "node scripts/release-lab.mjs",
    "release:web-vitals": "node scripts/release-web-vitals.mjs",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:import": "tsx scripts/import-data.ts",
    "data:database": "tsx scripts/build-database.ts",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "fflate": "^0.8.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
